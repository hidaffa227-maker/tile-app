<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Sensor Tile">
        <service android:name=".CameraTile" android:exported="true" android:label="Kamera"
            android:icon="@drawable/ic_camera" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>
        <service android:name=".MicTile" android:exported="true" android:label="Mikrofon"
            android:icon="@drawable/ic_mic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>
    </application>
</manifest>
